diff -Nur motorAutomation1-R1-0/iocs/automation1IOC/iocBoot/iocAutomation1/reset.sh motorAutomation1-R1-0/iocs/automation1IOC/iocBoot/iocAutomation1/reset.sh
--- motorAutomation1-R1-0/iocs/automation1IOC/iocBoot/iocAutomation1/reset.sh	1970-01-01 08:00:00.000000000 +0800
+++ motorAutomation1-R1-0/iocs/automation1IOC/iocBoot/iocAutomation1/reset.sh	2026-04-14 05:43:54.698687331 +0800
@@ -0,0 +1,10 @@
+#!/bin/sh -
+
+prefix="$1"; shift
+caput -cS "$prefix"ExecuteCommand "AcknowledgeAll()"
+while [ "$#" -gt 0 ]; do
+	caput -cS "$prefix"ExecuteCommand "Enable([$1])"
+	caput -cS "$prefix"ExecuteCommand "DriveEncoderOutputConfigureInput($1, EncoderOutputChannel.AuxiliaryEncoder, EncoderInputChannel.PrimaryEncoder)"
+	caput -cS "$prefix"ExecuteCommand "DriveEncoderOutputOn($1, EncoderOutputChannel.AuxiliaryEncoder, EncoderOutputMode.Quadrature)"
+shift; done
+
